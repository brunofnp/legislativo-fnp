# Vazio em dev é ok -- settings.py gera uma chave efêmera automaticamente
# quando DEBUG=True. Só é obrigatório preencher em produção (DEBUG=False).
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3

# Login com Google (criar em https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Monitoramento de erro (opcional em dev) — criar projeto Django em
# https://sentry.io, colar o DSN abaixo. Vazio = desligado.
SENTRY_DSN=

# CAPTCHA no cadastro (opcional em dev) — vazio = sem captcha nenhum no
# formulário. Ver .env.production.example pra como configurar de verdade.
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
