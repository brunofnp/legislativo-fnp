# Template para o .env real do droplet fnp-web (nunca commitar o .env de
# verdade — preencher isto e copiar manualmente para /opt/painel-legislativo/.env
# durante o deploy, guardando uma cópia também no Bitwarden).

DEBUG=False
SECRET_KEY=<gerar uma chave nova de produção — nunca reaproveitar a de dev>
ALLOWED_HOSTS=legislativo.fnp.org.br

# DATABASE_URL — cluster fnp-database (DigitalOcean), database/role dedicados
# (ver docs/runbook.md § Banco de produção para o CREATE ROLE/CREATE DATABASE).
# Nunca usar aqui o usuário doadmin/defaultdb — só a role legislativo_app.
#
# Testar primeiro a rota VPC privada (mais rápida, não depende de Trusted
# Sources por IP público) — só funciona se o droplet estiver na mesma VPC
# ou houver peering configurado entre as VPCs de NYC1 (fnp-web) e NYC3
# (fnp-database):
DATABASE_URL=postgresql://legislativo_app:<senha>@private-fnp-database-do-user-37776190-0.k.db.ondigitalocean.com:25060/legislativo?sslmode=require

# Se a rota privada não conectar (testar com nc/psql direto no droplet),
# usar a rota pública em vez da privada (droplet precisa estar nas Trusted
# Sources do fnp-database):
# DATABASE_URL=postgresql://legislativo_app:<senha>@fnp-database-do-user-37776190-0.k.db.ondigitalocean.com:25060/legislativo?sslmode=require

# Login com Google (criar em https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
