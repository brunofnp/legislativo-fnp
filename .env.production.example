# Template para o .env real do droplet fnp-web (nunca commitar o .env de
# verdade — preencher isto e copiar manualmente para /opt/legislativo-fnp/.env
# durante o deploy, guardando uma cópia também no Bitwarden).

DEBUG=False
SECRET_KEY=<gerar uma chave nova de produção — nunca reaproveitar a de dev>
ALLOWED_HOSTS=legislativo.fnp.org.br

# DATABASE_URL — cluster fnp-database (DigitalOcean), role/database já
# provisionados via painel DO: role "legislativo", database "legislativo_fnp"
# (nomes reais confirmados em 2026-08-04 — ver docs/runbook.md § Banco de
# produção, inclusive o GRANT que ainda falta confirmar). Nunca usar aqui o
# usuário doadmin/defaultdb — só a role legislativo.
#
# Testar primeiro a rota VPC privada (mais rápida, não depende de Trusted
# Sources por IP público) — só funciona se o droplet estiver na mesma VPC
# ou houver peering configurado entre as VPCs de NYC1 (fnp-web) e NYC3
# (fnp-database):
DATABASE_URL=postgresql://legislativo:<senha>@private-fnp-database-do-user-37776190-0.k.db.ondigitalocean.com:25060/legislativo_fnp?sslmode=require

# Se a rota privada não conectar (testar com nc/psql direto no droplet),
# usar a rota pública em vez da privada (droplet precisa estar nas Trusted
# Sources do fnp-database):
# DATABASE_URL=postgresql://legislativo:<senha>@fnp-database-do-user-37776190-0.k.db.ondigitalocean.com:25060/legislativo_fnp?sslmode=require

# Login com Google (criar em https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail transacional real (confirmação de cadastro, aviso de cadastro
# pendente, definir senha em conta só-Google) -- conta naoresponda@fnp.org.br
# no Google Workspace do domínio. EMAIL_HOST/PORT/USE_TLS já têm default
# certo pro Gmail (smtp.gmail.com:587, STARTTLS) em settings.py, só
# preencher usuário e senha de app abaixo (Conta Google > Segurança >
# Verificação em duas etapas > Senhas de app -- exige 2FA ativado nessa
# conta; a senha normal da conta NÃO funciona com SMTP).
EMAIL_HOST_USER=naoresponda@fnp.org.br
EMAIL_HOST_PASSWORD=<senha de app gerada no Google, 16 caracteres>

# Monitoramento de erro em produção — sem isso, uma queda só é percebida
# se alguém tentar acessar e avisar manualmente (como aconteceu nesta
# sessão). Criar um projeto Django gratuito em https://sentry.io e colar
# o DSN abaixo.
SENTRY_DSN=

# CAPTCHA no cadastro (opcional, mas recomendado — fórum de discussão
# política é alvo de cadastro em massa por bot). Criar reCAPTCHA v2
# "checkbox" em https://www.google.com/recaptcha/admin, associado ao
# domínio legislativo.fnp.org.br. Sem preencher as duas, o cadastro
# funciona normalmente sem captcha nenhum (nunca em modo "de teste").
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
